# Store text with LF line endings regardless of who commits it.
* text=auto eol=lf

# Windows scripts keep CRLF, which cmd.exe expects.
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.png binary

# Build output and lock files: hidden from diffs and from GitHub's language stats.
logiclayer/viewer/index.html linguist-generated=true -diff
web/package-lock.json linguist-generated=true -diff
benchmark/**/ground_truth*.pl linguist-generated=true
